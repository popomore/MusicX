---
import { messages } from '../locales/index.ts';
import type { Locale, Product } from './types';
import './site.css';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const copy = product.copy[locale];
const isChinese = locale === 'zh';
const home = isChinese ? '/zh/' : '/';
const origin = Astro.site!;
const canonical = new URL(home, origin).href;
const imageUrl = new URL(product.hero.src, origin).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': new URL('/#app', origin).href,
  name: product.name,
  url: canonical,
  description: copy.description,
  inLanguage: isChinese ? 'zh-CN' : 'en',
  operatingSystem: 'macOS 14 or later',
  processorRequirements: 'Apple Silicon',
  applicationCategory: product.id === 'musicx' ? 'MultimediaApplication' : 'UtilitiesApplication',
  image: imageUrl,
  ...(product.release ? {
    downloadUrl: product.release.download,
    softwareVersion: product.release.tag,
    releaseNotes: product.release.url,
  } : {}),
  license: `${product.repository}/blob/main/LICENSE`,
  sameAs: product.repository,
};
---

<!doctype html>
<html lang={isChinese ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content={product.id === 'musicx' ? '#f8f7f3' : '#f2f4f8'} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', origin).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL('/zh/', origin).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', origin).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isChinese ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={isChinese ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(product.hero.width)} />
    <meta property="og:image:height" content={String(product.hero.height)} />
    <meta property="og:image:alt" content={copy.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.title} />
    <meta name="twitter:description" content={copy.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={copy.imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
  </head>
  <body class={product.id} id="top">
    <a class="skip-link" href="#main">{messages[locale].accessibility.skipToContent}</a>
    <slot />
  </body>
</html>
