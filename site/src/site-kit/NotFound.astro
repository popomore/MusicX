---
import { messages } from '../locales/index.ts';
import './site.css';
interface Props { name: string }
const { name } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{messages.en.notFound.title} · {name}</title>
    <link rel="icon" type="image/png" href="/icon.png" />
  </head>
  <body>
    <main class="page-shell not-found">
      <p class="eyebrow">{name} · 404</p>
      <h1>{messages.en.notFound.title}</h1>
      <p lang="zh-CN">{messages.zh.notFound.description}</p>
      <div class="actions"><a class="button" href="/">{messages.en.notFound.home}</a><a class="text-link" href="/zh/" lang="zh-CN">{messages.zh.notFound.home}</a></div>
    </main>
  </body>
</html>
